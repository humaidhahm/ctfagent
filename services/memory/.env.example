NODE_ENV=development
PORT=3000
# Native-process connection settings. Compose uses the root ctfagent/.env.
DATABASE_URL=postgres://memory:memory-local-only@127.0.0.1:5434/memory
CSV_PATH=../../../picoctf_writeups_real.csv
PICOCTF_ARCHIVE_PATH=../../../github_trees/picoCTF__picoCTF.tar.gz
WEB_ALLOWED_HOSTS=raw.githubusercontent.com,github.com,medium.com
WEB_CACHE_TTL_SECONDS=86400
WEB_FETCH_TIMEOUT_MS=10000
WEB_MAX_BYTES=1000000
MEMORY_API_TOKEN=
MEMORY_REQUIRE_AUTH=false
MEMORY_CORS_ORIGINS=
WEB_MAX_CACHE_ROWS=1000
