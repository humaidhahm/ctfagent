# ─── Required ────────────────────────────────────────────────
LLM_PROVIDER=nim

# Get your free NVIDIA NIM API key at https://build.nvidia.com/
NVIDIA_NIM_API_KEYS=your_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Google AI keys are used for GEMMA and GEMINI providers.
# Multiple keys should be comma-separated. Google rate limits are per project,
# so keys from the same project share one quota bucket.
GOOGLE_API_KEYS=
GEMMA_MODEL=gemma-4-31b-it
GEMINI_MODEL=gemini-3.1-flash-lite
GOOGLE_MIN_REQUEST_INTERVAL_SECONDS=1

# ─── Agent Configuration ────────────────────────────────────
MAX_AGENT_ITERATIONS=20
MAX_TOOL_TIMEOUT_SECONDS=300
AGENT_TEMPERATURE=0.1

# ─── API Server ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ─── Storage ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
SESSION_TTL_SECONDS=3600

# ─── CTF Flag ──────────────────────────────────────────────
# Set to match your CTF's flag prefix (e.g. picoCTF, CTF, HTB)
FLAG_FORMAT=picoCTF

# ─── Optional: Pin specific NIM models per agent role ──────
# Leave empty to let the smart router auto-select.
# NIM_MODEL_SUPERVISOR=
# NIM_MODEL_CLASSIFIER=
# NIM_MODEL_WEB=
# NIM_MODEL_CRYPTO=
# NIM_MODEL_FORENSICS=
# NIM_MODEL_PWN=
# NIM_MODEL_RE=
# NIM_MODEL_MISC=
# NIM_MODEL_OSINT=


# ─── Memory Service ─────────────────────────────────────────
# The default database password is for isolated local development only.
MEMORY_SERVICE_URL=http://127.0.0.1:3001
MEMORY_ENABLED=true
MEMORY_TIMEOUT_SECONDS=5
# Set the same high-entropy token in the memory service environment to protect
# MCP and convenience routes. Leave empty only for loopback-only development.
MEMORY_API_TOKEN=
MEMORY_REQUIRE_AUTH=false
MEMORY_CORS_ORIGINS=
MEMORY_DB_PASSWORD=memory-local-only
# Canonical inputs are outside ctfagent in the parent workspace. Override these
# host paths only when using a different checkout layout.
MEMORY_CSV_PATH=../picoctf_writeups_real.csv
MEMORY_ARCHIVE_PATH=../github_trees/picoCTF__picoCTF.tar.gz